PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=devfiesta
DB_PASS=devfiesta
DB_NAME=devfiesta
# Set to "true" when connecting to a managed MySQL host (Aiven, Railway, etc.)
# that requires TLS. Leave unset for local Docker MySQL.
DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRATION=24h
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API.
# Local dev: http://localhost:3000
# Production: your Vercel deployment URL, e.g. https://devfiesta.vercel.app
CORS_ORIGIN=http://localhost:3000
