PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=devfiesta
DB_PASS=devfiesta
DB_NAME=devfiesta
# Set to "true" when connecting to a managed MySQL host (Aiven, Railway, etc.)
# that requires TLS. Leave unset for local Docker MySQL.
DB_SSL=false
# Most managed MySQL hosts present a self-signed CA that Node won't trust by
# default, causing "self-signed certificate in certificate chain" errors.
# Set to "false" to accept it. Only relevant when DB_SSL=true.
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRATION=24h
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API.
# Local dev: http://localhost:3000
# Production: your Vercel deployment URL, e.g. https://devfiesta.vercel.app
CORS_ORIGIN=http://localhost:3000
